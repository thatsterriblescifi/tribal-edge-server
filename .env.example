# Example placeholders only. Never commit real credentials.
TRIBAL_ENV=development
TRIBAL_BIND_ADDRESS=127.0.0.1
TRIBAL_PORT=8080

# Local Ollama endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=replace-with-your-local-model

# External providers should remain disabled until explicitly configured
# and permitted by policy.
EXTERNAL_ESCALATION_ENABLED=false

# Example only. Store real credentials in a suitable secrets manager.
# PRIVATE_LAB_API_KEY=
# PUBLIC_PROVIDER_API_KEY=
